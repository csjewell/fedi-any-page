{
  "name": "@csjewell-activitypub/json",
  "version": "0.1.0-alpha.1",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --allow-read",
    "test-update": "deno test --allow-read --allow-write -- --update"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true,
    "proseWrap": "always"
  },
  "license": "MIT",
  "imports": {
    "@hyperjump/json": "npm:@hyperjump/json@^0.2.1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/testing": "jsr:@std/testing@^1.0.9",
    "activitypub-core-types": "npm:activitypub-core-types@^0.3.2"
  },
  "publish": {
    "include": ["README.md", "LICENSE", "deno.jsonc"]
  }
}
