{
  "name": "@csjewell-activitypub/handlers-response",
  "version": "0.1.0",
  "description": "Generic Response handler for ActivityPub servers.",
  "type": "module",
  "main": "mod.ts",
  "scripts": {
    "test": "deno test --allow-read",
    "test-update": "deno test --allow-read --allow-write -- --update",
    "build": "tsup",
    "format": "prettier .",
    "lint": "eslint --flag unstable_config_lookup_from_file .",
    "tsc": "tsc"
  },
  "keywords": [],
  "files": [
    "LICENSE.md",
    "README.md",
    "lib/",
    "package.json"
  ],
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csjewell/activitypub-ts-kit.git"
  },
  "packageManager": "pnpm@10.7.1",
  "dependencies": {
    "@csjewell-activitypub/general": "workspace:^",
    "@csjewell-activitypub/json": "workspace:^",
    "@csjewell-activitypub/types": "workspace:^",
    "activitypub-http-signatures": "^2.5.0"
  },
  "engines": {
    "node": ">=23.6.0"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ],
    "**/*": "prettier --write --ignore-unknown"
  }
}
