{
  "name": "@csjewell-activitypub/eslint-config",
  "version": "0.2.0-alpha.2",
  "description": "ESLint options for @csjewell-activitypub",
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/eslint-config"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "type": "module",
  "main": "./index.ts",
  "exports": {
    "./index.ts": "./index.ts"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "nub run rolldown",
    "eslint": "eslint --config eslint.config.js",
    "knip": "knip",
    "prepublishOnly": "nub run rolldown",
    "rolldown": "rolldown --config",
    "tsc": "tsc"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/utils": "^8.62.1",
    "@vitest/eslint-plugin": "^1.6.9",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-no-restricted": "^0.1.1",
    "eslint-plugin-erasable-syntax-only": "^0.4.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-package-json": "^1.5.0",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-tsdoc": "^0.5.0",
    "eslint-plugin-unicorn": "^71.1.0",
    "eslint-plugin-yml": "^3.6.0",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.62.1",
    "yaml-eslint-parser": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "knip": "^6.25.0",
    "rolldown": "^1.1.4",
    "rolldown-plugin-dts": "^0.27.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "typings": "dist/index.d.ts"
  },
  "sideEffects": false
}
