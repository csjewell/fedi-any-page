{
  "name": "@csjewell-activitypub/eslint-config",
  "version": "0.1.2",
  "description": "ESLint options for @csjewell-activitypub",
  "type": "module",
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/eslint-config"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "main": "index.js",
  "publishConfig": {
    "main": "dist/index.js",
    "typings": "dist/index.d.ts"
  },
  "files": [
    "README.md",
    "dist/",
    "package.json"
  ],
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint --flag unstable_config_lookup_from_file",
    "prepublishOnly": "tsup",
    "tsc": "tsc"
  },
  "dependencies": {
    "@eslint/compat": "^1.2.8",
    "@eslint/js": "^9.24.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@typescript-eslint/utils": "^8.29.0",
    "@vitest/eslint-plugin": "^1.1.39",
    "eslint": "^9.24.0",
    "eslint-import-resolver-typescript": "^4.3.1",
    "eslint-no-restricted": "^0.0.8",
    "eslint-plugin-erasable-syntax-only": "^0.3.1",
    "eslint-plugin-import-x": "^4.10.0",
    "eslint-plugin-regexp": "^2.7.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.2",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-unicorn": "^58.0.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.29.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/node": "^22.14.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
