{
  "name": "@csjewell-activitypub/eslint-config",
  "version": "0.2.0-alpha.1",
  "description": "ESLint options for @csjewell-activitypub",
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/eslint-config"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "README.md",
    "dist/",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm tsup",
    "prepublishOnly": "pnpm tsup",
    "tsc": "tsc",
    "tsup": "tsup --config `git rev-parse --show-toplevel`/.config/tsup.config.ts"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@eslint/compat": "^1.2.8",
    "@eslint/js": "^9.25.1",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@typescript-eslint/utils": "^8.31.0",
    "@vitest/eslint-plugin": "^1.1.43",
    "eslint": "^9.25.1",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-no-restricted": "^0.0.8",
    "eslint-plugin-erasable-syntax-only": "^0.3.1",
    "eslint-plugin-import-x": "^4.10.6",
    "eslint-plugin-package-json": "^0.30.0",
    "eslint-plugin-regexp": "^2.7.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.2",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-unicorn": "^58.0.0",
    "eslint-plugin-yml": "^1.18.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.31.0",
    "yaml-eslint-parser": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.1",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "typings": "dist/index.d.ts"
  }
}
