{
  "name": "@csjewell-activitypub/eslint-config",
  "version": "0.2.0-alpha.2",
  "description": "ESLint options for @csjewell-activitypub",
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/eslint-config"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "type": "module",
  "main": "index.ts",
  "files": [
    "README.md",
    "dist/",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm tsup",
    "prepublishOnly": "pnpm tsup",
    "tsc": "tsc",
    "tsgo": "tsgo",
    "tsup": "tsup --config `git rev-parse --show-toplevel`/.config/tsup.config.ts"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.3",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@typescript-eslint/utils": "^8.62.1",
    "@vitest/eslint-plugin": "^1.6.9",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-no-restricted": "^0.0.10",
    "eslint-plugin-erasable-syntax-only": "^0.4.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-package-json": "^0.89.0",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-tsdoc": "^0.5.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-yml": "^1.19.1",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.62.1",
    "yaml-eslint-parser": "^1.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@typescript/native-preview": "7.0.0-dev.20260705.1",
    "tsup": "^8.5.1",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "typings": "dist/index.d.ts"
  }
}
