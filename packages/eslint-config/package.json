{
  "name": "@csjewell-activitypub/eslint-config",
  "version": "0.1.0",
  "description": "ESLint options for @csjewell-activitypub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csjewell/activitypub-ts-kit.git"
  },
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "LICENSE",
    "README.md",
    "dist/",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint --flag unstable_config_lookup_from_file",
    "prepublishOnly": "tsup",
    "tsc": "tsc"
  },
  "dependencies": {
    "@eslint/compat": "^1.2.8",
    "@eslint/js": "^9.24.0",
    "@onyx/esbuild-plugin-rewrite-relative-import-extensions": "npm:@jsr/onyx__esbuild-plugin-rewrite-relative-import-extensions@^0.0.2",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@typescript-eslint/utils": "^8.29.0",
    "@vitest/eslint-plugin": "^1.1.39",
    "eslint": "^9.24.0",
    "eslint-import-resolver-typescript": "^4.3.1",
    "eslint-no-restricted": "^0.0.8",
    "eslint-plugin-erasable-syntax-only": "^0.3.1",
    "eslint-plugin-import-x": "^4.10.0",
    "eslint-plugin-regexp": "^2.7.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.2",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-unicorn": "^58.0.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.29.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/node": "^22.14.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=23.6.0"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  }
}
