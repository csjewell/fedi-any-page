{
  "name": "@csjewell-activitypub/localserver-hapi",
  "version": "0.1.2",
  "description": "hapi-based server to do local testing with.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csjewell/activitypub-ts-kit.git"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "main": "index.ts",
  "files": [
    "README.md",
    "dist/",
    "package.json"
  ],
  "keywords": [],
  "scripts": {
    "build": "tsup",
    "lint": "eslint --flag unstable_config_lookup_from_file",
    "prepublishOnly": "tsup",
    "tsc": "tsc"
  },
  "dependencies": {
    "@csjewell-activitypub/database-mock": "workspace:^",
    "@csjewell-activitypub/general": "workspace:^",
    "@csjewell-activitypub/types": "workspace:^",
    "@hapi/hapi": "^21.4.0",
    "@keyv/sqlite": "^4.0.2",
    "brok": "^6.0.0",
    "keyv": "^5.3.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/node": "^22.14.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
