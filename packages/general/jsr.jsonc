{
  "name": "@csjewell-activitypub/general",
  "version": "0.2.0-alpha.2",
  "description": "Library to provide base classes and types for the ActivityPub toolkit.",
  "exports": {
    ".": "./index.ts",
    "./configuration": "./src/configuration.ts",
    "./database": "./src/database/mod.ts",
    "./database/router": "./src/database/router.ts",
    "./database/misc": "./src/database/misc.ts",
    "./database/session": "./src/database/session.ts",
    "./database/users": "./src/database/users.ts",
    "./errors": "./src/errors.ts",
    "./request": "./src/request.ts",
    "./responses": "./src/responses.ts",
    "./server": "./src/server/mod.ts",
    "./users": "./src/users.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "jsr.jsonc",
      "index.ts",
      "src/**/*.ts"
    ]
  }
}

