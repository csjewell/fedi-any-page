{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@csjewell-activitypub/general",
  "version": "0.2.0-alpha.2",
  "description": "Library to provide base classes and types for the ActivityPub toolkit.",
  "keywords": [
    "activitypub"
  ],
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/general"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "attw": "attw",
    "build": "nub run rolldown",
    "e18e": "e18e-cli",
    "eslint": "eslint --config .config/eslint.config.js",
    "knip": "knip --config .config/knip.packages.jsonc",
    "prepublishOnly": "nub run rolldown",
    "publint": "publint",
    "rolldown": "rolldown --config .config/rolldown.config.ts; rolldown --config .config/rolldown.dts.config.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "tsc": "tsc"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --config .config/eslint.config.js --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@csjewell-activitypub/types": "workspace:^",
    "@dewars/cuid2": "jsr:^0.1.0",
    "@hyperjump/json": "^0.2.1",
    "@std/uuid": "jsr:^1.1.0",
    "@types/sanitize-html": "^2.16.0",
    "@valibot/valibot": "jsr:^1.0.0",
    "keyv": "^5.6.0",
    "sanitize-html": "^2.17.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@e18e/cli": "^0.7.0",
    "@types/node": "^22.19.11",
    "@typescript-eslint/parser": "^8.64.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.7.0",
    "knip": "^6.27.0",
    "publint": "^0.3.21",
    "rolldown": "^1.1.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js"
    },
    "typings": "./dist/index.d.ts"
  }
}
