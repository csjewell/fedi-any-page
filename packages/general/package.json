{
  "name": "@csjewell-activitypub/general",
  "version": "0.2.0-alpha.2",
  "description": "Library to provide base classes and types for the ActivityPub toolkit.",
  "keywords": [
    "activitypub"
  ],
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/general"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "type": "module",
  "main": "index.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "nub run rolldown",
    "prepublishOnly": "nub run rolldown",
    "rolldown": "rolldown --config",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "tsc": "tsc"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@csjewell-activitypub/types": "workspace:^",
    "@dewars/cuid2": "jsr:^0.1.0",
    "@hyperjump/json": "^0.2.1",
    "@std/uuid": "jsr:^1.1.0",
    "@types/sanitize-html": "^2.16.0",
    "@valibot/valibot": "jsr:^1.0.0",
    "keyv": "^5.6.0",
    "sanitize-html": "^2.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.6.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "typings": "dist/index.d.ts"
  }
}
