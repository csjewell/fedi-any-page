{
  "name": "@csjewell-activitypub/general",
  "version": "0.2.0-alpha.2",
  "description": "Library to provide base classes and types for the ActivityPub toolkit.",
  "keywords": [
    "activitypub"
  ],
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/general"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "type": "module",
  "main": "index.ts",
  "files": [
    "README.md",
    "dist/",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm tsup",
    "prepublishOnly": "pnpm tsup",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "tsc": "tsc",
    "tsup": "tsup --config `git rev-parse --show-toplevel`/.config/tsup.config.ts"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@csjewell-activitypub/types": "workspace:^",
    "@dewars/cuid2": "jsr:^0.1.0",
    "@hyperjump/json": "^0.2.1",
    "@std/uuid": "jsr:^1.0.7",
    "@types/sanitize-html": "^2.15.0",
    "@valibot/valibot": "jsr:^1.0.0",
    "keyv": "^5.3.3",
    "sanitize-html": "^2.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "typings": "dist/index.d.ts"
  }
}
