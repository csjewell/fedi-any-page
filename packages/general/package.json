{
  "name": "@csjewell-activitypub/general",
  "version": "0.1.2",
  "description": "Library to provide base classes and types for the ActivityPub toolkit.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csjewell/activitypub-ts-kit.git"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "main": "index.ts",
  "publishConfig": {
    "main": "dist/index.js",
    "typings": "dist/index.d.ts"
  },
  "files": [
    "README.md",
    "dist/",
    "package.json"
  ],
  "keywords": [
    "activitypub"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint --flag unstable_config_lookup_from_file",
    "prepublishOnly": "tsup",
    "tsc": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@csjewell-activitypub/types": "workspace:^",
    "@dewars/cuid2": "npm:@jsr/dewars__cuid2@^0.1.0",
    "@hyperjump/json": "^0.2.1",
    "@keyv/sqlite": "^4.0.1",
    "@std/jsonc": "npm:@jsr/std__jsonc@^1.0.1",
    "@std/uuid": "npm:@jsr/std__uuid@^1.0.6",
    "@types/sanitize-html": "^2.15.0",
    "keyv": "npm:keyv@^5.3.2",
    "sanitize-html": "npm:sanitize-html@^2.14.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@csjewell-activitypub/eslint-config": "workspace:^",
    "@types/node": "^22.14.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "tsup": "^8.4.0",
    "typedoc": "^0.28.2",
    "typedoc-plugin-markdown": "^4.6.2",
    "typedoc-plugin-mdn-links": "^5.0.1",
    "typedoc-plugin-missing-exports": "^4.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
