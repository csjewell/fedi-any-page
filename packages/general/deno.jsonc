{
  "name": "@csjewell-activitypub/general",
  "version": "0.1.0",
  "exports": {
    ".": "./mod.ts",
    "./database/router": "./database/router.ts",
    "./database/handler": "./database/handler.ts",
    "./database/misc": "./database/misc.ts",
    "./database/session": "./database/session.ts",
    "./database/users": "./database/users.ts",
    "./configuration": "./configuration.ts",
    "./errors": "./errors.ts",
    "./requests": "./requests.ts",
    "./responses": "./responses.ts",
    "./server": "./server/mod.ts",
    "./users": "./users.ts"
  },
  "tasks": {
    "lint": "deno eslint --allow-read",
    "test": "deno test --allow-read",
    "test-update": "deno test --allow-read --allow-write -- --update"
  },
  "license": "MIT",
  "imports": {
    "@csjewell-activitypub/types": "../types/mod.ts",
    "@dewars/cuid2": "jsr:@dewars/cuid2@^0.1.0",
    "@eslint/compat": "npm:@eslint/compat@^1.2.8",
    "@eslint/js": "npm:@eslint/js@^9.23.0",
    "@keyv/sqlite": "npm:@keyv/sqlite@^4.0.1",
    "@paralleldrive/cuid2": "npm:@paralleldrive/cuid2@^2.2.2",
    "@std/assert": "jsr:@std/assert@1",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.1",
    "@std/testing": "jsr:@std/testing@^1.0.9",
    "@std/uuid": "jsr:@std/uuid@^1.0.4",
    "@stylistic/eslint-plugin": "npm:@stylistic/eslint-plugin@^4.2.0",
    "@vitest/eslint-plugin": "npm:@vitest/eslint-plugin@^1.1.38",
    "eslint": "npm:eslint@^9.23.0",
    "eslint-no-restricted": "npm:eslint-no-restricted@^0.0.8",
    "eslint-plugin-erasable-syntax-only": "npm:eslint-plugin-erasable-syntax-only@^0.3.0",
    "eslint-plugin-import-x": "npm:eslint-plugin-import-x@^4.10.0",
    "eslint-plugin-regexp": "npm:eslint-plugin-regexp@^2.7.0",
    "eslint-plugin-simple-import-sort": "npm:eslint-plugin-simple-import-sort@^12.1.1",
    "eslint-plugin-sonarjs": "npm:eslint-plugin-sonarjs@^3.0.2",
    "eslint-plugin-tsdoc": "npm:eslint-plugin-tsdoc@^0.4.0",
    "eslint-plugin-unicorn": "npm:eslint-plugin-unicorn@^58.0.0",
    "globals": "npm:globals@^16.0.0",
    "keyv": "npm:keyv@^5.3.2",
    "sanitize-html": "npm:sanitize-html@^2.14.0",
    "typescript-eslint": "npm:typescript-eslint@^8.29.0"
  },
  "publish": {
    "include": [
      "README.md",
      "LICENSE",
      "deno.jsonc",
      "mod.ts",
      "configuration.ts",
      "database/*.ts",
      "server/*.ts",
      "server/*/*.ts",
      "errors.ts",
      "responses.ts",
      "handlers.ts",
      "utilities.ts",
      "interfaces.ts",
      "users.ts"
    ]
  },
  "compilerOptions": {
    "strict": true
  },
  "unstable": [
    "sloppy-imports"
  ]
}
