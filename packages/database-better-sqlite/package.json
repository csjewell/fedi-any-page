{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@csjewell-activitypub/database-better-sqlite",
  "version": "0.2.0-alpha.2",
  "description": "sqlite database to do local testing with.",
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/database-better-sqlite"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "index.ts"
  },
  "main": "index.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "nub run rolldown",
    "prepublishOnly": "nub run rolldown",
    "publint": "publint",
    "rolldown": "rolldown --config",
    "tsc": "tsc"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@csjewell-activitypub/general": "workspace:^",
    "@csjewell-activitypub/types": "workspace:^",
    "@keyv/sqlite": "^4.0.8",
    "better-sqlite3": "^12.11.1",
    "keyv": "^5.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.6.0",
    "publint": "^0.3.21",
    "rolldown": "^1.1.4",
    "rolldown-plugin-dts": "^0.27.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "exports": {
      ".": "dist/index.js"
    },
    "main": "dist/index.js"
  }
}
