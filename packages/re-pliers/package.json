{
  "name": "@csjewell-activitypub/re-pliers",
  "version": "0.2.0-alpha.2",
  "description": "Widget to make ActivityPub replies show up.",
  "keywords": [
    "ActivityPub",
    "federation",
    "fediverse"
  ],
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/re-pliers"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "README.md",
    "dist/",
    "package.json"
  ],
  "scripts": {
    "build": "vite build",
    "build:preview": "vite preview",
    "dev:watch": "vite",
    "lint": "eslint",
    "lint:git": "lint-staged",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "tsgo": "tsgo",
    "tsc": "tsc"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ],
    "**/*.md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "browserslist": [
    "fully supports es6-module and fully supports css-nesting"
  ],
  "dependencies": {
    "@ant-design/icons-svg": "^4.4.2",
    "@csjewell-activitypub/general": "workspace:^",
    "@nesterow/grip": "jsr:^0.0.3",
    "@valibot/valibot": "jsr:^1.0.0",
    "htm": "^3.1.1",
    "humanize-duration-ts": "^2.1.1",
    "js-cookie": "^3.0.5",
    "preact": "^10.28.4",
    "preact-markup": "^2.1.1",
    "tailored": "github:nesterow/tailored"
  },
  "devDependencies": {
    "@fetch-mock/vitest": "^0.2.18",
    "@preact/preset-vite": "^2.10.3",
    "@testing-library/preact": "^3.2.4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.19.11",
    "@typescript/native-preview": "7.0.0-dev.20260705.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.25.1",
    "fetch-mock": "^12.6.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.8",
    "rollup-plugin-ts-treeshaking": "^1.0.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "6.0.3",
    "unplugin-info": "^1.2.4",
    "unplugin-isolated-decl": "^0.13.11",
    "vite": "^6.4.1",
    "vite-plugin-static-copy": "^2.3.2",
    "vite-plugin-version-mark": "^0.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "module": "dist/re-pliers.mjs",
    "exports": {
      ".": "dist/re-pliers.mjs"
    },
    "typings": "dist/re-pliers.d.ts"
  }
}
