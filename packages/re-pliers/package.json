{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@csjewell-activitypub/re-pliers",
  "version": "0.2.0-alpha.2",
  "description": "Widget to make ActivityPub replies show up.",
  "keywords": [
    "ActivityPub",
    "federation",
    "fediverse"
  ],
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/re-pliers"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./index.ts": "./src/index.ts"
  },
  "main": "src/index.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "vite build",
    "build:preview": "vite preview",
    "dev:watch": "vite",
    "e18e": "e18e-cli",
    "eslint": "eslint --config eslint.config.js",
    "lint": "nub run eslint",
    "lint:git": "lint-staged",
    "prepublishOnly": "nub run build",
    "publint": "publint",
    "rolldown": "rolldown --config",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "tsc": "tsc"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --config eslint.config.js --fix"
    ],
    "**/*.md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "browserslist": [
    "fully supports es6-module and fully supports css-nesting"
  ],
  "dependencies": {
    "@ant-design/icons-svg": "^4.4.2",
    "@csjewell-activitypub/general": "workspace:^",
    "@nesterow/grip": "jsr:^0.0.3",
    "@valibot/valibot": "jsr:^1.0.0",
    "htm": "^3.1.1",
    "humanize-duration-ts": "^2.1.1",
    "js-cookie": "^3.0.5",
    "preact": "^10.29.5",
    "preact-markup": "^2.1.1",
    "tailored": "github:nesterow/tailored"
  },
  "devDependencies": {
    "@fetch-mock/vitest": "^0.2.18",
    "@preact/preset-vite": "^2.10.3",
    "@testing-library/preact": "^3.2.4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.19.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "fetch-mock": "^12.6.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "publint": "^0.3.21",
    "rolldown": "^1.1.4",
    "rollup-plugin-ts-treeshaking": "^1.0.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-info": "^1.2.4",
    "unplugin-isolated-decl": "^0.16.0",
    "vite": "^8.1.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-version-mark": "^0.2.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "exports": {
      ".": "dist/re-pliers.mjs"
    },
    "module": "dist/re-pliers.mjs",
    "typings": "dist/re-pliers.d.ts"
  }
}
