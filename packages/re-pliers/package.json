{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@csjewell-activitypub/re-pliers",
  "version": "0.2.0-alpha.2",
  "description": "Widget to make ActivityPub replies show up.",
  "keywords": [
    "ActivityPub",
    "federation",
    "fediverse"
  ],
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/re-pliers"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "attw": "attw",
    "build": "vite build",
    "build:preview": "vite preview",
    "dev:watch": "vite",
    "e18e": "e18e-cli",
    "eslint": "eslint --config .config/eslint.config.js",
    "knip": "knip --config .config/knip.packages.jsonc",
    "lint": "nub run eslint",
    "lint:git": "lint-staged",
    "markdownlint": "markdownlint-cli2 \"**/*.md\" !node_modules",
    "prepublishOnly": "nub run rolldown",
    "publint": "publint",
    "rolldown": "rolldown --config .config/rolldown.config.ts; rolldown --config .config/rolldown.dts.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "tsc": "tsc"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --config .config/eslint.config.js --fix"
    ],
    "**/*.md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "browserslist": [
    "fully supports es6-module and fully supports css-nesting"
  ],
  "dependencies": {
    "@ant-design/icons-svg": "^4.5.0",
    "@csjewell-activitypub/general": "workspace:^",
    "@kamod-ch/signals": "^1.0.3",
    "@nesterow/grip": "jsr:^0.0.3",
    "@preact/signals": "^2.11.1",
    "@valibot/valibot": "jsr:^1.4.2",
    "htm": "^3.1.1",
    "humanize-duration-ts": "^2.1.1",
    "js-cookie": "^3.0.8",
    "preact": "^10.29.7",
    "preact-custom-element": "^4.6.0",
    "preact-markup": "^2.1.1",
    "tailored": "github:nesterow/tailored"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@e18e/cli": "^0.7.0",
    "@fetch-mock/vitest": "^0.2.18",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/preact": "^3.2.4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "22.20.1",
    "@typescript-eslint/parser": "^8.64.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "fetch-mock": "^12.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.27.0",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.23.0",
    "publint": "^0.3.22",
    "rolldown": "^1.1.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-info": "^1.3.2",
    "vite": "^8.1.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-version-mark": "^0.2.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/re-pliers.mjs"
    },
    "module": "./dist/re-pliers.mjs"
  }
}
