{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./.config/tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",

    "lib": ["DOM", "ES2023"],

    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["node", "js-cookie", "preact", "vite"],
  },
  "include": ["node_modules/vite/client.d.ts", "index.ts", "src"]
}
