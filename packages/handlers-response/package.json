  "main": "./index.ts",
  "exports": {
    "./index.ts": "./index.ts"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "nub run rolldown",
    "eslint": "eslint --config eslint.config.js",
    "knip": "knip",
