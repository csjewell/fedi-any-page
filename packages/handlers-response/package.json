{
  "name": "@csjewell-activitypub/handlers-response",
  "version": "0.2.0-alpha.2",
  "description": "Generic Response handler for ActivityPub servers.",
  "keywords": [
    "ActivityPub"
  ],
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
