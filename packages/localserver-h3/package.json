{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@csjewell-activitypub/localserver-h3",
  "version": "0.2.0-alpha.2",
  "description": "h3-based server to do local testing with.",
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/localserver-h3"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "attw": "attw",
    "build": "nub run rolldown",
    "e18e": "e18e-cli",
    "eslint": "eslint --config .config/eslint.config.js",
    "knip": "knip --config .config/knip.packages.jsonc",
    "prepublishOnly": "nub run rolldown",
    "publint": "publint",
    "rolldown": "rolldown --config .config/rolldown.config.ts; rolldown --config .config/rolldown.dts.config.ts",
    "serve": "listhen --open ./index.ts",
    "serve:watch": "listhen --watch ../ --open ./index.ts",
    "tsc": "tsc"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --config .config/eslint.config.js --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@csjewell-activitypub/database-better-sqlite": "workspace:^",
    "@csjewell-activitypub/general": "workspace:^",
    "@csjewell-activitypub/handlers-response": "workspace:^",
    "@csjewell-activitypub/types": "workspace:^",
    "@keyv/sqlite": "^4.0.8",
    "h3": "^1.15.11",
    "h3-compression": "^0.3.2",
    "h3-valibot": "^0.1.0",
    "keyv": "^5.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@e18e/cli": "^0.7.0",
    "@types/node": "22.20.1",
    "@typescript-eslint/parser": "^8.64.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.7.0",
    "knip": "^6.27.0",
    "listhen": "^1.9.0",
    "publint": "^0.3.22",
    "rolldown": "^1.1.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-info": "^1.3.2"
  },
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js"
    },
    "typings": "./dist/index.d.ts"
  }
}
