{
  "name": "@csjewell-activitypub/types",
  "version": "0.1.2",
  "description": "Types library for ActivityPub messages.",
  "type": "module",
  "homepage": "https://fedi-any-page.curtisjewell.dev",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page",
    "directory": "packages/types"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "main": "index.ts",
  "publishConfig": {
    "main": "dist/index.js",
    "typings": "dist/index.d.ts"
  },
  "files": [
    "README.md",
    "dist/",
    "package.json"
  ],
  "keywords": [],
  "scripts": {
    "build": "tsup",
    "lint": "eslint --flag unstable_config_lookup_from_file",
    "prepublishOnly": "tsup",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@csjewell-activitypub/eslint-config": "workspace:^",
    "@types/node": "^22.14.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
