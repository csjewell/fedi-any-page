{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-mdn-links", "typedoc-plugin-missing-exports"],
  "entryPoints": ["packages/*"],
  "packageOptions": {
    "entryPoints": ["index.ts"],
  },
  "entryPointStrategy": "packages",
  "includeVersion": false,
  "excludeExternals": true,
  "outputs": [{
    "name": "html",
    "path": "new-docs",
    "router": "structure",
    "lang": "en-021",
    "hideGenerator": true,
    "searchInDocuments": true,
  },{
    "name": "markdown",
    "path": "new-docs-md",
    "router": "structure",
  }]
}

