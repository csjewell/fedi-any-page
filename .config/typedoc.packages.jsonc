{
  "$schema": "https://typedoc.org/schema.json",
  "includeVersion": true,
  "disableSources": true,
  "excludeExternals": true,
  "externalPattern": [
    "../types/**/*.ts",
    "../general/**/*.ts",
    "./node_modules",
  ],
}

