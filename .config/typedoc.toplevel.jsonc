// SPDX-FileCopyrightText: NONE
{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-plugin-frontmatter",
    "typedoc-plugin-mdn-links",
    "typedoc-plugin-missing-exports",
    "typedoc-plugin-remark",
    "./helpers/typedoc.js"
  ],
  "entryPoints": ["../packages/*"],
  "packageOptions": {
    "entryPoints": ["index.ts"],
    "includeVersion": true,
    "excludeExternals": true,
    "disableSources": true,
  },
  "entryPointStrategy": "packages",
  "includeVersion": false,
  "excludeExternals": true,
  "cleanOutputDir": true,
  "out": "../../fedi-any-page-docs/content/en/docs/latest",
  "router": "module",
  "entryFileName": "start",
  "excludeScopesInPaths": true,
  "expandParameters": true,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "indexFormat": "table",
  "parametersFormat": "table",
  "tableColumnSettings": {
    "hideDefaults": false,
    "hideInherited": false,
    "hideModifiers": false,
    "hideOverrides": false,
    "hideSources": false,
    "hideValues": false,
    "leftAlignHeaders": false
  },
  "useHTMLAnchors": true,
  "anchorPrefix": "tdmd-",
  "navigation": {
    "includeCategories": false,
    "includeGroups": false,
    "includeFolders": true,
    "compactFolders": false,
    "excludeReferences": true
  },
  "categorizeByGroup": false,
  "remarkPlugins": ["remark-frontmatter", "./.config/helpers/remark.js"],
  "publicPath": "https://fedi-any-page.curtisjewell.dev/docs/latest",
}

