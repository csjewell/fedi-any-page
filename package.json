{
  "name": "@csjewell-activitypub/monorepo",
  "version": "0.2.0-alpha.2",
  "description": "ActivityPub Typescript Kit monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "type": "module",
  "workspaces": [
    "packages/eslint-config",
    "packages/types",
    "packages/general",
    "packages/re-pliers",
    "packages/handlers-response",
    "packages/database-cloudflare-d1",
    "packages/database-mock",
    "packages/database-node-sqlite",
    "packages/database-better-sqlite",
    "packages/localserver-h3",
    "packages/localserver-hapi"
  ],
  "exports": {
    "./index.ts": "./index.ts"
  },
  "files": [
    "index.ts"
  ],
  "scripts": {
    "bumpp": "cd `git rev-parse --show-toplevel`; bumpp --no-verify",
    "commitlint": "commitlint",
    "eslint": "cd `git rev-parse --show-toplevel`; eslint --config .config/eslint.config.js",
    "postinstall": "husky",
    "knip": "knip",
    "lint": "nub run eslint",
    "markdownlint": "markdownlint-cli2 \"**/*.md\" !node_modules !**/node_modules !proposed",
    "publish": "true",
    "tsc": "tsc",
    "typedoc:html": "cd `git rev-parse --show-toplevel`; typedoc --options .config/typedoc.html.jsonc",
    "typedoc:md": "cd `git rev-parse --show-toplevel`; typedoc --options .config/typedoc.toplevel.jsonc"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --config .config/eslint.config.js --fix"
    ],
    "**/*.md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@csjewell-activitypub/eslint-config": "workspace:^",
    "@e18e/cli": "^0.7.0",
    "@types/node": "^22.20.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bumpp": "^11.1.0",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^10.2.0",
    "cz-conventional-changelog": "^3.3.0",
    "cz-git": "^1.13.1",
    "escalade": "^3.2.0",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "knip": "^6.26.0",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.23.0",
    "remark-link-rewrite": "^1.0.7",
    "rolldown": "^1.1.4",
    "rolldown-plugin-dts": "^0.27.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-missing-exports": "^4.1.3",
    "typedoc-plugin-remark": "^2.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.62.1"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "sideEffects": false,
  "knip": {
    "tags": [
      "-lintignore"
    ],
    "workspaces": {
      ".": {
        "eslint": false,
        "entry": [
          "bin/get_current_version.js",
          "bin/npmtag.js",
          ".config/helpers/*.js",
          ".config/bump.config.ts",
          ".config/rolldown.config.ts"
        ],
        "typedoc": {
          "config": [
            ".config/typedoc.*.jsonc"
          ]
        }
      },
      "packages/*": {
        "eslint": false,
        "ignore": "eslint.config.js"
      }
    }
  },
  "markdownlint-cli2": {
    "config": {
      "first-line-heading": false,
      "line-length": {
        "code_block_line_length": 125
      }
    }
  }
}
