{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@csjewell-activitypub/monorepo",
  "displayName": "ActivityPub Monorepo",
  "version": "0.2.0-alpha.2",
  "private": true,
  "description": "ActivityPub Typescript Kit monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://git.sr.ht/~csjewell/fedi-any-page"
  },
  "license": "MIT",
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "sideEffects": false,
  "type": "module",
  "workspaces": [
    "packages/eslint-config",
    "packages/types",
    "packages/general",
    "packages/re-pliers",
    "packages/handlers-response",
    "packages/database-cloudflare-d1",
    "packages/database-mock",
    "packages/database-node-sqlite",
    "packages/database-better-sqlite",
    "packages/localserver-h3",
    "packages/localserver-hapi"
  ],
  "scripts": {
    "bumpp": "bumpp --no-verify",
    "changeset": "changeset",
    "commitlint": "commitlint",
    "e18e": "e18e-cli",
    "eslint": "eslint --config .config/eslint.config.js",
    "postinstall": "husky",
    "jsr": "jsr",
    "knip": "knip",
    "lint": "nub run eslint",
    "lint-staged": "lint-staged",
    "markdownlint": "markdownlint-cli2 \"**/*.md\" !node_modules !**/node_modules !proposed",
    "publish": "true",
    "tsc": "tsc",
    "typedoc:html": "typedoc --options .config/typedoc.html.jsonc",
    "typedoc:md": "typedoc --options .config/typedoc.toplevel.jsonc"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --config .config/eslint.config.js --fix"
    ],
    "!(.changeset)**/*.md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.2",
    "@csjewell-activitypub/commit-config": "workspace:^",
    "@csjewell-activitypub/eslint-config": "workspace:^",
    "@e18e/cli": "^0.7.0",
    "@nubjs/nub": "^0.4.13",
    "@types/node": "22.20.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bumpp": "^11.1.0",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "cz-conventional-changelog": "^3.3.0",
    "cz-git": "^1.14.0",
    "escalade": "^3.2.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jsr": "^0.14.3",
    "knip": "^6.33.0",
    "lint-staged": "^17.4.1",
    "markdownlint-cli2": "^0.23.2",
    "publint": "^0.3.24",
    "remark-link-rewrite": "^1.0.7",
    "rolldown": "^1.2.6",
    "rolldown-plugin-dts": "^0.27.14",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.13.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typedoc-plugin-remark": "^2.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "unplugin-info": "^1.3.2"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "knip": {
    "tags": [
      "-lintignore"
    ],
    "workspaces": {
      ".": {
        "eslint": false,
        "entry": [
          "bin/package-json-update.ts",
          "bin/get_current_version.js",
          ".config/helpers/*.js",
          ".config/bump.config.ts",
          ".config/rolldown.config.ts"
        ],
        "ignore": [
          ".config/*.config.*",
          "packages/*/.config/*.config.*",
          "packages/*/.config/helpers/*.js",
          "proposed/**"
        ],
        "ignoreDependencies": [
          "preact",
          "@typescript-eslint/parser",
          "rolldown-plugin-dts",
          "cz-conventional-changelog"
        ],
        "typedoc": {
          "config": [
            ".config/typedoc.*.jsonc"
          ]
        }
      },
      "packages/*": {
        "eslint": false
      }
    }
  },
  "markdownlint-cli2": {
    "config": {
      "first-line-heading": false,
      "line-length": {
        "code_block_line_length": 125
      }
    }
  }
}
