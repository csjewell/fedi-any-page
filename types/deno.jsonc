    "@std/uuid": "jsr:@std/uuid@^1.0.4"
  },
  "publish": {
    "include": [
      "README.md",
      "LICENSE",
      "deno.jsonc",
      "mod.ts",
      "Activity.ts",
      "Actor.ts",
      "Collection.ts",
      "CoreObject.ts",
      "CoreUtility.ts",
      "Entity.ts",
      "ExtendedObject.ts",
      "Link.ts",
      "TypeAssert.ts",
      "TypeCast.ts",
      "TypeGuard.ts",
