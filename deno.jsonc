{
  // Each JSR package is in this list`
  "workspace": [
    "./json",
    "./general",
    "./handlers-response",
    "./database-cloudflare-d1",
    "./workers-cloudflare"
  ],
  // Set the compiler options for TypeScript.
  "compilerOptions": {
    "strict": true,
    "verbatimModuleSyntax": true
  },
  // No node_modules, even for npm-style.
  "nodeModulesDir": "none",
  // Do not format or lint test data, snapshots, or documentation site.
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true,
    "proseWrap": "always",
    "exclude": [
      "test_data",
      "__snapshots__",
      ".github",
      "docsite",
      "CONTRIBUTING.md"
    ]
  },
  "lint": {
    "exclude": ["test_data", "__snapshots__", ".github", "docsite"]
  }
}
