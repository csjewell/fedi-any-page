{
  // Each JSR package is in this list
  "workspace": ["./json"],
  // Set the compiler options for TypeScript.
  "compilerOptions": {
    "strict": true,
    "verbatimModuleSyntax": true
  },
  // No node_modules, even for npm-style.
  "nodeModulesDir": "none",
  // Do not format or lint test data or snapshots.
  "fmt": {
    "exclude": ["test_data", "__snapshots__", ".github"]
  },
  "lint": {
    "exclude": ["test_data", "__snapshots__", ".github"]
  }
}
