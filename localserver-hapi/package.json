{
  "name": "@csjewell-activitypub/localserver-hapi",
  "version": "0.1.0",
  "description": "hapi-based server to local testing.",
  "type": "module",
  "main": "mod.ts",
  "scripts": {
    "test": "deno test --allow-read",
    "test-update": "deno test --allow-read --allow-write -- --update",
    "build": "tsup",
    "format": "prettier .",
    "lint": "eslint --flag unstable_config_lookup_from_file .",
    "tsc": "tsc"
  },
  "keywords": [],
  "files": [
    "LICENSE.md",
    "README.md",
    "lib/",
    "package.json"
  ],
  "author": {
    "name": "Curtis Jewell",
    "email": "swordsman+aptypescript@curtisjewell.name"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csjewell/activitypub-ts-kit.git"
  },
  "packageManager": "pnpm@10.7.1",
  "dependencies": {
    "@hapi/hapi": "^21.4.0",
    "@keyv/sqlite": "^4.0.2",
    "brok": "^6.0.0",
    "keyv": "^5.3.2"
  },
  "engines": {
    "node": ">=23.6.0"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ],
    "**/*": "prettier --write --ignore-unknown"
  }
}
