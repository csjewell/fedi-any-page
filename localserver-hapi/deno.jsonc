{
  "name": "@csjewell-activitypub/localserver-hapi",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --allow-read",
    "test-update": "deno test --allow-read --allow-write -- --update"
  },
  "license": "MIT",
  "imports": {
    "@hapi/hapi": "npm:@hapi/hapi@^21.4.0",
    "@keyv/sqlite": "npm:@keyv/sqlite@^4.0.1",
    "brok": "npm:brok@^6.0.0",
    "keyv": "npm:keyv@^5.3.2"
  },
  "publish": {
    "include": [
      "README.md",
      "LICENSE",
      "deno.jsonc",
      "index.ts",
      "configuration.ts",
      "database.ts",
      "request.ts",
      "responses.ts"
    ]
  }
}
